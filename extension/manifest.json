{
  "manifest_version": 3,
  "name": "Pala — Kréta Bővítmény",
  "version": "1.0.0",
  "description": "Modern, nyílt forráskódú Kréta böngészőbővítmény élő órarenddel, jegyekkel és értesítésekkel.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Pala Kréta Kliens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.e-kreta.hu/*",
    "https://mobil.e-kreta.hu/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; frame-ancestors 'none';"
  }
}
