{
  "manifest_version": 3,
  "name": "Pala — Kréta Bővítmény",
  "version": "1.1.0",
  "description": "Modern, nyílt forráskódú Kréta böngészőbővítmény élő órarenddel, jegyekkel, szellem jegy kalkulátorral és oldalsávval.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Pala Kréta Kliens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "sidebar_action": {
    "default_panel": "sidepanel/sidepanel.html",
    "default_title": "Pala — Kréta Oldalsáv",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "scripts": [
      "shared/kreta_api.js",
      "background/service_worker.js"
    ]
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "webNavigation",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.e-kreta.hu/*",
    "https://mobil.e-kreta.hu/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pala@pala.edu.hu",
      "strict_min_version": "109.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; frame-ancestors 'none';"
  }
}
